---
import Layout from '../layouts/Layout.astro';
import Nav from './Nav.astro';
import PrintResume from './PrintResume.astro';
import { languages, type Language } from '../data/i18n';
import { techBadges, skillCategories, tools, contactLinks } from '../data/site';
import reposData from '../data/repos.json';

interface Props {
  lang: Language;
  isHome?: boolean;
}

const { lang, isHome = false } = Astro.props;
const t = languages[lang];

interface Repo {
  id: number;
  name: string;
  description: string | null;
  language: string | null;
  stargazers_count: number;
  forks_count: number;
  html_url: string;
  updated_at: string;
  archived: boolean;
  fork: boolean;
}

const repos = reposData as Repo[];

// Bento "constructor": pick k leading bricks to render double-wide so the
// 3-col grid tiles into a perfect rectangle — (n + k) % 3 === 0, k <= n/2.
// Repos arrive pre-sorted by rank (CI bake sorts by stars + forks*2), so the
// biggest bricks are always the top projects. Wide/slim bricks interleave
// (wide, slim, wide, slim, …) so rows fill left-to-right with zero holes;
// grid-auto-flow: dense in CSS is only a safety net.
function bentoLayout(list: Repo[]) {
  const n = list.length;
  let k = 0;
  for (let cand = Math.floor(n / 2); cand > 0; cand--) {
    if ((n + cand) % 3 === 0) { k = cand; break; }
  }
  const cells = list.map((r, i) => ({ r, wide: i < k }));
  const normals = cells.slice(k);
  const out: { r: Repo; wide: boolean }[] = [];
  for (let i = 0; i < k; i++) out.push(cells[i], normals[i]);
  out.push(...normals.slice(k));
  return out;
}

const isHot = (r: Repo) => !r.fork && !r.archived && r.stargazers_count >= 5;

const cells = bentoLayout(repos);

const dateLocale = { en: 'en-US', ru: 'ru-RU', zh: 'zh-CN' }[lang];
const formatDate = (iso: string) =>
  new Date(iso).toLocaleDateString(dateLocale, { year: 'numeric', month: 'short', day: 'numeric' });
---

<Layout lang={lang} isHome={isHome}>
  <!-- Aurora background -->
  <div class="fixed inset-0 -z-10 overflow-hidden pointer-events-none" aria-hidden="true">
    <div class="aurora-bg"></div>
    <div class="aurora-blob blob-1"></div>
    <div class="aurora-blob blob-2"></div>
    <div class="aurora-blob blob-3"></div>
    <div class="aurora-overlay"></div>
  </div>

  <Nav lang={lang} nav={t.nav} />

  <!-- Hero -->
  <section id="hero" class="relative flex flex-col items-center justify-center px-6 lg:px-10 pt-8 pb-10 lg:pt-10 lg:pb-12 no-print reveal">
    <div class="max-w-4xl mx-auto w-full text-center relative z-10">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full badge-glow border border-slate-200/50 dark:border-white/[0.08] text-[13px] font-medium text-slate-500 dark:text-slate-400 mb-4">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>{t.hero.status}</span>
      </div>
      <h1 class="text-[clamp(3rem,8vw,6rem)] font-black tracking-tight leading-[1.05] mb-4">
        <span class="block">Evgeniy</span>
        <span class="block gradient-text animate-shimmer">Gleba</span>
      </h1>
      <p class="text-[clamp(1.15rem,2.4vw,1.5rem)] text-slate-500 dark:text-slate-400 mb-8 max-w-2xl mx-auto font-light leading-relaxed">{t.hero.tagline}</p>
      <div class="flex flex-wrap justify-center gap-3 mb-8">
        <a href="#projects" class="group inline-flex items-center gap-2.5 px-6 py-3.5 text-[15px] bg-slate-900 dark:bg-white text-white dark:text-slate-900 rounded-xl font-semibold hover:opacity-90 transition-all hover:scale-[1.02]">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"/></svg>
          <span>{t.hero.viewProjects}</span>
          <svg class="w-4 h-4 group-hover:translate-y-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/></svg>
        </a>
        <button type="button" data-print class="pdf-glass group inline-flex items-center gap-2.5 px-6 py-3.5 text-[15px] rounded-xl font-medium transition-all hover:scale-[1.02]" title="Print resume">
          <svg class="w-5 h-5 group-hover:scale-105 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9V2h12v7"/><path d="M6 18H4a2 2 0 01-2-2v-5a2 2 0 012-2h16a2 2 0 012 2v5a2 2 0 01-2 2h-2"/><path d="M6 14h12v8H6z"/></svg>
          <span>PDF</span>
        </button>
      </div>
      <!-- Tech badges -->
      <div class="flex flex-wrap justify-center gap-2 mb-6">
        {techBadges.map((badge) => (
          <div class="tech-badge">
            {badge.icon && <img src={badge.icon} class="w-4 h-4" alt="" width="16" height="16" decoding="async" />}
            {badge.svg && <span class="w-4 h-4 inline-flex items-center justify-center" set:html={badge.svg} />}
            <span>{badge.label}</span>
          </div>
        ))}
      </div>
      <!-- Stats — 3 cards only -->
      <div class="grid grid-cols-3 gap-3 max-w-md mx-auto reveal-stagger">
        <div class="stat-cell stat-glass">
          <div class="text-2xl md:text-3xl font-bold gradient-text">3+</div>
          <div class="text-[13px] text-slate-500 dark:text-slate-400 mt-1">{t.stats.years}</div>
        </div>
        <div class="stat-cell stat-glass">
          <div class="text-2xl md:text-3xl font-bold gradient-text">25+</div>
          <div class="text-[13px] text-slate-500 dark:text-slate-400 mt-1">{t.stats.repos}</div>
        </div>
        <div class="stat-cell stat-glass">
          <div class="text-2xl md:text-3xl font-bold gradient-text">5</div>
          <div class="text-[13px] text-slate-500 dark:text-slate-400 mt-1">{t.stats.platforms}</div>
        </div>
      </div>
    </div>
  </section>

  <!-- About -->
  <section id="about" class="py-8 lg:py-12 px-6 lg:px-10 no-print reveal cv-auto">
    <div class="max-w-6xl mx-auto">
      <h2 class="text-[clamp(2rem,4vw,2.75rem)] font-bold mb-5 lg:mb-7">{t.about.label}</h2>
      <div class="grid lg:grid-cols-5 gap-8 lg:gap-12">
        <div class="lg:col-span-3 space-y-4 text-[16px] text-slate-600 dark:text-slate-400 leading-[1.75]">
          <p>{t.about.p1}</p>
          <p>{t.about.p2}</p>
          <p>{t.about.p3}</p>
        </div>
        <div class="lg:col-span-2 space-y-4">
          <div class="card-glass p-5 card-glass-hover">
            <p class="font-mono text-[12px] text-brand-pink mb-2 font-semibold uppercase tracking-wider">{t.about.philosophy}</p>
            <p class="text-[14px] text-slate-600 dark:text-slate-400 leading-[1.7]">{t.about.p4}</p>
          </div>
          <div class="card-glass p-5 card-glass-hover">
            <p class="font-mono text-[12px] text-brand-orange mb-2 font-semibold uppercase tracking-wider">{t.about.impact.label}</p>
            <ul class="space-y-2 text-[14px] text-slate-600 dark:text-slate-400">
              {t.about.impact.items.map((item) => (
                <li class="flex items-start gap-2">
                  <span class="text-brand-pink mt-1 shrink-0">›</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Experience -->
  <section id="experience" class="py-8 lg:py-12 px-6 lg:px-10 no-print reveal cv-auto">
    <div class="max-w-6xl mx-auto">
      <h2 class="text-[clamp(2rem,4vw,2.75rem)] font-bold mb-5 lg:mb-7">{t.experience.label}</h2>
      <div class="max-w-3xl">
        <div class="timeline">
          {t.experience.items.map((item) => (
            <div class="timeline-entry">
              <span class="timeline-year">{item.year}</span>
              <div class="timeline-title">{item.title}</div>
              {item.company && <div class="timeline-company">{item.company}</div>}
              <div class="timeline-desc">{item.desc}</div>
              {item.tags.length > 0 && (
                <div class="flex flex-wrap gap-2 mt-2">
                  {item.tags.map((tag) => (
                    <span class="px-2 py-0.5 text-[11px] rounded-md bg-slate-100 dark:bg-white/[0.05] font-mono border border-slate-200 dark:border-white/[0.06] text-slate-500 dark:text-slate-400">{tag}</span>
                  ))}
                </div>
              )}
              {item.link && (
                <a href={item.link} target="_blank" rel="noopener noreferrer"
                   class="inline-flex items-center gap-1.5 text-[14px] text-brand-pink hover:underline mt-2 font-medium">
                  <span>{item.linkText || 'Watch'}</span>
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                </a>
              )}
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Projects — Bento Grid -->
  <section id="projects" class="py-8 lg:py-12 px-6 lg:px-10 no-print reveal cv-auto">
    <div class="max-w-6xl mx-auto">
      <h2 class="text-[clamp(2rem,4vw,2.75rem)] font-bold mb-5 lg:mb-7">{t.projects.label}</h2>
      <div class="bento-grid">
        {cells.map((cell) => (
          <article class={`bento-cell card-glass card-glass-hover p-5 group${cell.wide ? ' span-2 bento-featured' : ''}`}>
            <div class="flex items-start justify-between mb-3">
              <h3 class="text-[16px] font-bold font-mono text-brand-pink truncate max-w-[70%]">{cell.r.name}</h3>
              {isHot(cell.r) && (
                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-[10px] font-bold uppercase tracking-wider bg-gradient-to-r from-brand-pink to-brand-orange text-white shrink-0">Hot</span>
              )}
            </div>
            <p class="text-[14px] text-slate-500 dark:text-slate-400 mb-4 line-clamp-2 leading-relaxed">{cell.r.description || t.projects.noDesc}</p>
            <div class="flex flex-wrap gap-1.5 mb-4">
              {cell.r.language && (
                <span class="px-2 py-0.5 text-[11px] rounded-md bg-slate-100 dark:bg-white/[0.05] font-mono border border-slate-200 dark:border-white/[0.06]">{cell.r.language}</span>
              )}
              <span class="px-2 py-0.5 text-[11px] rounded-md bg-slate-100 dark:bg-white/[0.05] flex items-center gap-1 border border-slate-200 dark:border-white/[0.06]">
                <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                <span>{cell.r.stargazers_count}</span>
              </span>
              {cell.r.forks_count > 0 && (
                <span class="px-2 py-0.5 text-[11px] rounded-md bg-slate-100 dark:bg-white/[0.05] flex items-center gap-1 border border-slate-200 dark:border-white/[0.06]">
                  <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 16 16"><path d="M5 5.372v.878c0 .414.336.75.75.75h4.5a.75.75 0 0 0 .75-.75v-.878a2.25 2.25 0 1 1 1.5 0v.878a2.25 2.25 0 0 1-2.25 2.25h-1.5v2.128a2.251 2.251 0 1 1-1.5 0V8.5h-1.5A2.25 2.25 0 0 1 3.5 6.25v-.878a2.25 2.25 0 1 1 1.5 0ZM5 3.25a.75.75 0 1 0-1.5 0 .75.75 0 0 0 1.5 0Zm6.75.75a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Zm-3 8.75a.75.75 0 1 0-1.5 0 .75.75 0 0 0 1.5 0Z"/></svg>
                  <span>{cell.r.forks_count}</span>
                </span>
              )}
            </div>
            <div class="flex items-center justify-between mt-auto">
              <a href={cell.r.html_url} class="inline-flex items-center gap-1.5 text-[13px] font-semibold text-brand-pink hover:underline" target="_blank" rel="noopener noreferrer">
                <span>{t.projects.view}</span>
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
              </a>
              <time class="text-[11px] text-slate-400 font-mono" datetime={cell.r.updated_at}>{formatDate(cell.r.updated_at)}</time>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Skills — horizontal bento cards -->
  <section id="skills" class="py-8 lg:py-12 px-6 lg:px-10 no-print reveal cv-auto">
    <div class="max-w-6xl mx-auto">
      <h2 class="text-[clamp(2rem,4vw,2.75rem)] font-bold mb-5 lg:mb-7">{t.skills.label}</h2>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4 reveal-stagger">
        {skillCategories.map((cat) => (
          <div class="card-glass card-glass-hover p-5 lg:p-6">
            <h3 class="text-[17px] font-bold mb-4 flex items-center gap-3" style={`color:${cat.color}`}>
              <svg class="w-5 h-5" aria-hidden="true"><use href={`#i-cat-${cat.key}`} /></svg>
              <span>{t.skills[cat.key]}</span>
            </h3>
            <ul class="space-y-2.5">
              {cat.items.map((item) => (
                <li class="flex items-center gap-3 text-[14px] text-slate-600 dark:text-slate-400">
                  {item.svg ? (
                    <span class="w-5 h-5 inline-flex items-center justify-center text-brand-pink shrink-0 skill-svg" aria-hidden="true" set:html={item.svg} />
                  ) : item.img ? (
                    <img src={item.img} class="w-5 h-5 shrink-0" alt="" loading="lazy" width="20" height="20" decoding="async" />
                  ) : (
                    <span class="text-brand-pink shrink-0" aria-hidden="true">·</span>
                  )}
                  <span>{item.label}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Tools & Resources -->
  <section id="tools" class="py-8 lg:py-12 px-6 lg:px-10 no-print reveal cv-auto">
    <div class="max-w-6xl mx-auto">
      <div class="mb-5 lg:mb-7">
        <h2 class="text-[clamp(2rem,4vw,2.75rem)] font-bold">{t.tools.label}</h2>
        <p class="text-[15px] text-slate-500 dark:text-slate-400 mt-2">{t.tools.subtitle}</p>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4 reveal-stagger">
        {tools.map((group) => (
          <div class="card-glass card-glass-hover p-5">
            <h3 class="text-[14px] font-bold font-mono uppercase tracking-wider text-brand-pink mb-4">{group.label}</h3>
            <div class="flex flex-wrap gap-2">
              {group.items.map((tool) => (
                <a href={tool.url} target="_blank" rel="noopener noreferrer" class="tool-chip group/tool" title={tool.desc}>
                  {tool.icon && <img src={tool.icon} class="w-4 h-4" alt="" loading="lazy" width="16" height="16" />}
                  {tool.svg && <span class="w-4 h-4 inline-flex items-center justify-center text-current" set:html={tool.svg} />}
                  <span class="text-[12px]">{tool.name}</span>
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Contact -->
  <section id="contact" class="py-8 lg:py-12 px-6 lg:px-10 no-print reveal cv-auto">
    <div class="max-w-6xl mx-auto text-center">
      <h2 class="text-[clamp(2rem,4vw,2.75rem)] font-bold mb-4 lg:mb-6">{t.contact.label}</h2>
      <p class="text-[16px] text-slate-500 dark:text-slate-400 mb-8 max-w-xl mx-auto leading-[1.75]">{t.contact.text}</p>
      <div class="flex flex-wrap justify-center gap-3">
        {contactLinks.map((link) => (
          <a href={link.href} class="contact-link" target="_blank" rel="noopener noreferrer" aria-label={link.label}>
            <span set:html={link.svg} />
            <span>{link.label}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Share -->
  <section id="share" class="py-8 px-6 lg:px-10 no-print border-t border-rc-light-border dark:border-rc-dark-border bg-rc-light-card dark:bg-rc-dark-card reveal cv-auto">
    <div class="max-w-6xl mx-auto text-center">
      <p class="text-[13px] text-slate-500 dark:text-slate-400 mb-4">{t.share.subtitle}</p>
      <div class="shareon flex flex-wrap justify-center gap-2" data-url="https://e-gleba.github.io" data-title="Evgeniy Gleba — C++ Systems Engineer">
        <a class="twitter" data-title="Evgeniy Gleba — C++ Systems Engineer"></a>
        <a class="bluesky" data-title="Evgeniy Gleba — C++ Systems Engineer"></a>
        <a class="telegram" data-title="Evgeniy Gleba — C++ Systems Engineer"></a>
        <a class="linkedin" data-title="Evgeniy Gleba — C++ Systems Engineer"></a>
        <a class="copy-url"></a>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="py-5 px-6 lg:px-10 bg-rc-light-bg dark:bg-rc-dark-bg border-t border-rc-light-border dark:border-rc-dark-border text-center text-[13px] text-slate-500 no-print">
    <p>
      © 2026 Evgeniy Gleba ·
      <span>{t.footer}</span> ·
      <a href="https://github.com/e-gleba/e-gleba.github.io" class="hover:text-brand-pink transition-colors inline-flex items-center gap-1.5 font-medium" target="_blank" rel="noopener noreferrer">
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
        source
      </a>
    </p>
  </footer>

  <!-- Back to top -->
  <button type="button" data-back-to-top class="no-print fixed bottom-5 right-5 p-3 bg-slate-900 dark:bg-white text-white dark:text-slate-900 rounded-xl shadow-xl transition-all z-40 hover:scale-105" aria-label="Back to top">
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18"/></svg>
  </button>

  <PrintResume lang={lang} />
</Layout>

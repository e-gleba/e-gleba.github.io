---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import PrintResume from '../components/PrintResume.astro';
import { t, localeMeta, type Locale } from '../i18n';
import { site } from '../data/site';
import repos from '../data/repos.json';

interface Props { locale: Locale }
const { locale } = Astro.props;
const i = t[locale];
const meta = localeMeta[locale];

const base = import.meta.env.BASE_URL;

const skillIcon = (slug: string, color = 'white') =>
  `https://cdn.simpleicons.org/${slug}/${color}`;

const badgeIcons: Record<string, string> = {
  'C++23': 'cplusplus', 'CMake': 'cmake', 'Python': 'python', 'TypeScript': 'typescript',
  'Astro': 'astro', 'Tailwind': 'tailwindcss', 'Bash': 'gnubash', 'Docker': 'docker',
  'Linux': 'linux', 'Vulkan': 'vulkan', 'OpenGL': 'opengl', 'GitHub Actions': 'githubactions',
};

const toolIcons: Record<string, string> = {
  'CLion': 'clion', 'Neovim': 'neovim', 'VS Code': 'visualstudiocode', 'Zed': 'zedindustries',
  'Ghostty': 'ghostty', 'Tmux': 'tmux', 'Fish': 'fishshell', 'Yazi': 'yazi',
  'Zsh': 'zsh', 'WezTerm': 'wezterm', 'Git': 'git', 'GitHub': 'github',
  'Docker': 'docker', 'Ansible': 'ansible', 'CMake': 'cmake', 'Ninja': 'ninja',
  'Conan': 'conan', 'vcpkg': 'vcpkg', 'Linux': 'linux', 'Arch': 'archlinux',
  'Nix': 'nixos', 'macOS': 'apple', 'FreeBSD': 'freebsd', 'Astro': 'astro',
  'Tailwind': 'tailwindcss', 'React': 'react', 'Next.js': 'nextdotjs',
  'Cloudflare': 'cloudflare', 'Vercel': 'vercel',
};

const contactIcons: Record<string, { icon?: string; svg?: string }> = {
  email: { svg: '<path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>' },
  github: { icon: 'github' },
  linkedin: { icon: 'linkedin' },
  telegram: { icon: 'telegram' },
  discord: { icon: 'discord' },
};

const communityIcons: Record<string, string> = {
  'next.js': 'nextdotjs', 'nixpkgs': 'nixos', 'mold': 'githubactions',
  'sentry': 'sentry', 'vulkan': 'vulkan', 'open-source': 'opensourceinitiative',
};
---

<Layout
  title={meta.title}
  description={meta.description}
  locale={locale}
  lang={meta.lang}
  keywords={meta.keywords}
>
  <Nav locale={locale} />

  <main id="main">
    {/* ==================== HERO — Linear/Raycast-style neon glow ==================== */}
    <section id="hero" class="hero-band relative min-h-screen w-full flex flex-col items-center justify-center overflow-hidden bg-[#000000] px-6 py-24">
      {/* Ambient glow layer: two static radial-gradient circles, blur(120px).
          No animation, no JS — rasterized once by the compositor. */}
      <div class="absolute inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
        <div class="hero-glow-crimson"></div>
        <div class="hero-glow-indigo"></div>
      </div>

      {/* PDF — top-right corner, above the glow */}
      <button onclick="window.print()" class="pdf-glass no-print absolute top-6 right-6 z-20 inline-flex items-center gap-2 px-4 py-2.5 text-sm font-medium">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
        </svg>
        PDF
      </button>

      {/* Centered content */}
      <div class="relative z-10 flex flex-col items-center text-center max-w-4xl mx-auto">
        <p class="font-mono text-sm md:text-base text-zinc-500 tracking-widest uppercase mb-5">
          {t.hero.tagline}
        </p>

        <h1 class="text-5xl md:text-7xl font-extrabold tracking-tight text-white mb-6">
          {t.hero.name}
        </h1>

        <p class="text-lg text-zinc-400 max-w-xl leading-relaxed mb-10">
          {t.hero.description}
        </p>

        {/* CTAs */}
        <div class="flex flex-wrap justify-center gap-4 mb-14">
          <a href="https://github.com/e-gleba" target="_blank" rel="noopener noreferrer"
             class="inline-flex items-center gap-2 rounded-lg bg-white px-7 py-3 text-sm font-bold text-black transition-opacity hover:opacity-90">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
            GitHub
          </a>
          <a href={`mailto:${site.email}?subject=${encodeURIComponent(i.contact.emailSubject)}&body=${encodeURIComponent(i.contact.emailBody)}`}
             class="inline-flex items-center gap-2 rounded-lg border border-zinc-800 px-7 py-3 text-sm font-semibold text-white transition-colors hover:border-zinc-600">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
            {t.hero.email}
          </a>
        </div>

        {/* Tech badges */}
        <div class="flex flex-wrap justify-center gap-2 max-w-2xl mb-14">
          {i.about.techStack.map((tech) => (
            <span class="tech-badge">
              {badgeIcons[tech] && (
                <img src={skillIcon(badgeIcons[tech])} alt="" width="12" height="12" loading="lazy" decoding="async" />
              )}
              {tech}
            </span>
          ))}
        </div>

        {/* Stats */}
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-8 max-w-3xl mx-auto w-full pt-8 border-t border-white/10">
          {i.about.stats.map((stat) => (
            <div class="stat-cell">
              <div class="text-2xl md:text-3xl font-bold gradient-text">{stat.value}</div>
              <div class="text-xs text-rc-light-muted dark:text-rc-dark-muted mt-1">{stat.label}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* ==================== ABOUT ==================== */}
    <section id="about" class="cv-auto max-w-4xl mx-auto px-6 py-20">
      <h2 class="text-3xl font-bold mb-8 flex items-center gap-3">
        <span class="w-8 h-[2px] bg-gradient-to-r from-brand-pink to-brand-orange"></span>
        {i.about.title}
      </h2>
      <p class="text-rc-light-muted dark:text-rc-dark-muted leading-relaxed text-lg">
        {i.about.text}
      </p>
    </section>

    {/* ==================== PROJECTS ==================== */}
    <section id="projects" class="cv-auto max-w-6xl mx-auto px-6 py-20">
      <h2 class="text-3xl font-bold mb-2 flex items-center gap-3">
        <span class="w-8 h-[2px] bg-gradient-to-r from-brand-pink to-brand-orange"></span>
        {i.projects.title}
      </h2>
      <p class="text-rc-light-muted dark:text-rc-dark-muted mb-10 ml-11">{i.projects.subtitle}</p>
      <div class="bento-grid">
        {repos.map((repo) => (
          <a
            href={repo.url}
            target="_blank"
            rel="noopener noreferrer"
            class={`bento-cell card-glass card-glass-hover p-5 no-underline text-inherit${repo.w > 1 ? ' span-2 bento-featured' : ''}${repo.h > 1 ? ' span-2-row' : ''}`}
          >
            <div class="flex items-center justify-between mb-2">
              <span class="font-semibold text-[0.95rem]">{repo.name}</span>
              <span class="flex items-center gap-3 text-xs text-rc-light-muted dark:text-rc-dark-muted shrink-0 ml-2">
                {repo.lang && (
                  <span class="flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full inline-block" style={`background:${repo.langColor}`}></span>
                    {repo.lang}
                  </span>
                )}
                {repo.stars > 0 && (
                  <span class="flex items-center gap-1">
                    <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 16 16">
                      <path d="M8 .25a.75.75 0 01.673.418l1.882 3.815 4.21.612a.75.75 0 01.416 1.279l-3.046 2.97.719 4.192a.75.75 0 01-1.088.791L8 12.347l-3.766 1.98a.75.75 0 01-1.088-.79l.72-4.194L.818 6.374a.75.75 0 01.416-1.28l4.21-.611L7.327.668A.75.75 0 018 .25z"/>
                    </svg>
                    {repo.stars}
                  </span>
                )}
              </span>
            </div>
            <p class="text-sm text-rc-light-muted dark:text-rc-dark-muted leading-relaxed m-0">
              {repo.description}
            </p>
          </a>
        ))}
      </div>
    </section>

    {/* ==================== EXPERIENCE ==================== */}
    <section id="experience" class="cv-auto max-w-4xl mx-auto px-6 py-20">
      <h2 class="text-3xl font-bold mb-10 flex items-center gap-3">
        <span class="w-8 h-[2px] bg-gradient-to-r from-brand-pink to-brand-orange"></span>
        {i.experience.title}
      </h2>
      <div class="timeline">
        {i.experience.entries.map((entry) => (
          <div class="timeline-entry">
            <span class="timeline-year">{entry.year}</span>
            <div class="timeline-title">{entry.title}</div>
            <div class="timeline-company">{entry.company}</div>
            <p class="timeline-desc">{entry.description}</p>
          </div>
        ))}
      </div>
    </section>

    {/* ==================== SKILLS ==================== */}
    <section id="skills" class="cv-auto max-w-4xl mx-auto px-6 py-20">
      <h2 class="text-3xl font-bold mb-10 flex items-center gap-3">
        <span class="w-8 h-[2px] bg-gradient-to-r from-brand-pink to-brand-orange"></span>
        {i.skills.title}
      </h2>
      <div class="grid md:grid-cols-3 gap-4">
        {i.skills.categories.map((cat) => (
          <div class="card-glass card-glass-hover p-6">
            <h3 class="font-semibold mb-4 text-sm uppercase tracking-wider text-rc-light-muted dark:text-rc-dark-muted">
              {cat.name}
            </h3>
            <div class="flex flex-wrap gap-2">
              {cat.skills.map((skill) => (
                <span class="tech-badge">
                  {badgeIcons[skill] && (
                    <img src={skillIcon(badgeIcons[skill])} alt="" width="12" height="12" loading="lazy" decoding="async" />
                  )}
                  {skill}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    {/* ==================== TOOLS ==================== */}
    <section id="tools" class="cv-auto max-w-4xl mx-auto px-6 py-20">
      <h2 class="text-3xl font-bold mb-2 flex items-center gap-3">
        <span class="w-8 h-[2px] bg-gradient-to-r from-brand-pink to-brand-orange"></span>
        {i.tools.title}
      </h2>
      <p class="text-rc-light-muted dark:text-rc-dark-muted mb-10 ml-11">{i.tools.subtitle}</p>
      <div class="grid md:grid-cols-2 gap-4">
        {i.tools.categories.map((cat) => (
          <div class="card-glass card-glass-hover p-6">
            <h3 class="font-semibold mb-4 text-sm uppercase tracking-wider text-rc-light-muted dark:text-rc-dark-muted">
              {cat.name}
            </h3>
            <div class="flex flex-wrap gap-2">
              {cat.items.map((tool) => (
                <span class="tool-chip">
                  {toolIcons[tool] && (
                    <img src={skillIcon(toolIcons[tool])} alt="" width="14" height="14" loading="lazy" decoding="async" />
                  )}
                  {tool}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    {/* ==================== COMMUNITY ==================== */}
    <section id="community" class="cv-auto max-w-4xl mx-auto px-6 py-20">
      <h2 class="text-3xl font-bold mb-2 flex items-center gap-3">
        <span class="w-8 h-[2px] bg-gradient-to-r from-brand-pink to-brand-orange"></span>
        {i.community.title}
      </h2>
      <p class="text-rc-light-muted dark:text-rc-dark-muted mb-10 ml-11">{i.community.subtitle}</p>
      <div class="space-y-4">
        {i.community.contributions.map((c) => (
          <div class="card-glass card-glass-hover p-5 flex items-start gap-4">
            <div class="mt-1 shrink-0 w-8 h-8 rounded-lg bg-rc-light-card dark:bg-rc-dark-card border border-rc-light-border dark:border-rc-dark-border flex items-center justify-center">
              {communityIcons[c.project] ? (
                <img src={skillIcon(communityIcons[c.project])} alt="" width="16" height="16" loading="lazy" decoding="async" />
              ) : (
                <svg class="w-4 h-4 text-rc-light-muted dark:text-rc-dark-muted" fill="currentColor" viewBox="0 0 16 16">
                  <path d="M8 0a8 8 0 100 16A8 8 0 008 0zM1.5 8a6.5 6.5 0 0110.535-5.096l-9.131 9.131A6.472 6.472 0 011.5 8zm6.5 6.5a6.47 6.47 0 01-3.596-1.096l9.131-9.131A6.5 6.5 0 018 14.5z"/>
                </svg>
              )}
            </div>
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2 flex-wrap">
                <span class="font-semibold text-sm">{c.project}</span>
                <span class="text-xs px-2 py-0.5 rounded-full bg-rc-light-card dark:bg-rc-dark-card border border-rc-light-border dark:border-rc-dark-border text-rc-light-muted dark:text-rc-dark-muted">
                  {c.type}
                </span>
              </div>
              <p class="text-sm text-rc-light-muted dark:text-rc-dark-muted mt-1 mb-2">{c.description}</p>
              {c.href && (
                <a href={c.href} target="_blank" rel="noopener noreferrer"
                   class="text-xs font-mono text-brand-pink dark:text-brand-orange hover:underline break-all">
                  {c.href.replace('https://', '')}
                </a>
              )}
            </div>
          </div>
        ))}
      </div>
    </section>

    {/* ==================== CONTACT ==================== */}
    <section id="contact" class="cv-auto max-w-4xl mx-auto px-6 py-20">
      <h2 class="text-3xl font-bold mb-10 flex items-center gap-3">
        <span class="w-8 h-[2px] bg-gradient-to-r from-brand-pink to-brand-orange"></span>
        {i.contact.title}
      </h2>
      <div class="flex flex-wrap gap-3">
        {i.contact.links.map((link) => {
          const c = contactIcons[link.key];
          return (
            <a href={link.href} target="_blank" rel="noopener noreferrer" class="contact-link">
              {c?.icon && (
                <img src={skillIcon(c.icon, '8a8a95')} alt="" width="16" height="16" loading="lazy" decoding="async" />
              )}
              {c?.svg && (
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" set:html={c.svg} />
              )}
              {link.label}
            </a>
          );
        })}
      </div>
    </section>

    {/* ==================== FOOTER ==================== */}
    <footer class="cv-auto max-w-4xl mx-auto px-6 py-12 text-center">
      <p class="text-sm text-rc-light-muted dark:text-rc-dark-muted">
        {i.footer.text}
      </p>
      <p class="text-xs text-rc-light-muted dark:text-rc-dark-muted mt-2 opacity-60">
        {i.footer.builtWith}
      </p>
    </footer>
  </main>

  <PrintResume locale={locale} />
</Layout>

<script>
  // Scroll reveal — IntersectionObserver, no framework
  const observer = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (e.isIntersecting) {
          e.target.classList.add('revealed');
          observer.unobserve(e.target);
        }
      }
    },
    { threshold: 0.1 }
  );
  document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
</script>

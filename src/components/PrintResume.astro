---
import { languages, type Language } from '../data/i18n';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const items = languages[lang].experience.items;
---

<!-- Print resume — visible only via @media print -->
<div class="print-only max-w-[210mm] mx-auto p-[20mm] text-slate-900 bg-white font-sans text-[11pt] leading-relaxed">
  <header class="border-b-2 border-slate-900 pb-4 mb-6">
    <h1 class="text-[28pt] font-bold tracking-tight">Evgeniy Gleba</h1>
    <p class="text-[12pt] text-slate-600 mt-1">C++ Systems Engineer · Game Engine Developer · Reverse Engineer</p>
    <div class="flex flex-wrap gap-x-4 gap-y-1 mt-2 text-[10pt] text-slate-700">
      <span>i@egleba.ru</span>
      <span>github.com/e-gleba</span>
      <span>t.me/egleba</span>
      <span>Minsk, Belarus</span>
    </div>
  </header>
  <section class="mb-5">
    <h2 class="text-[12pt] font-bold uppercase tracking-wider border-b border-slate-300 pb-1 mb-2">Professional Summary</h2>
    <p class="text-[10.5pt]">Systems engineer with 3+ years shipping cross-platform C++ in production game engines. Specialized in performance-critical systems: graphics pipelines, asset streaming, memory management. Proven track record at Lesta Games (Engine Core, Tanks Blitz). Reverse engineering background with published open-source tooling. 25+ public repositories, 5-platform deployment (Linux, Windows, macOS, iOS, Android).</p>
  </section>
  <section class="mb-5">
    <h2 class="text-[12pt] font-bold uppercase tracking-wider border-b border-slate-300 pb-1 mb-2">Core Competencies</h2>
    <div class="grid grid-cols-2 gap-x-6 gap-y-1 text-[10pt]">
      <div><strong class="text-[10.5pt]">Languages:</strong> C++20 / C++23, C17 / C23, Python 3, Bash / PowerShell</div>
      <div><strong class="text-[10.5pt]">Systems:</strong> CMake, Linux, Git/GitHub Actions, Docker, LLVM/Clang</div>
      <div><strong class="text-[10.5pt]">Engine:</strong> SDL3, OpenGL/GLSL, Tracy Profiler, Wwise Audio</div>
      <div><strong class="text-[10.5pt]">Mobile:</strong> Android SDK/NDK, iOS/Obj-C++, Cross-platform Native</div>
      <div><strong class="text-[10.5pt]">Reverse Eng:</strong> Ghidra, Memory Analysis, Binary Patching</div>
      <div><strong class="text-[10.5pt]">Practices:</strong> Static Analysis, Generic Programming, constexpr/consteval</div>
    </div>
  </section>
  <section class="mb-5">
    <h2 class="text-[12pt] font-bold uppercase tracking-wider border-b border-slate-300 pb-1 mb-2">Professional Experience</h2>
    <div class="space-y-2 text-[10pt]">
      {items.map((item) => (
        <div class="flex gap-3">
          <div class="shrink-0 w-20 text-right font-mono font-bold text-[10.5pt]">{item.year}</div>
          <div class="flex-1">
            <div class="font-bold text-[10.5pt]">{item.title}</div>
            {item.company && <div class="text-slate-600 italic">{item.company}</div>}
            <div class="text-slate-700">{item.desc}</div>
          </div>
        </div>
      ))}
    </div>
  </section>
  <section class="mb-5">
    <h2 class="text-[12pt] font-bold uppercase tracking-wider border-b border-slate-300 pb-1 mb-2">Selected Projects</h2>
    <div class="space-y-3 text-[10pt]">
      <div>
        <div class="flex justify-between items-baseline">
          <strong class="text-[11pt]">airstrike3d-tools</strong>
          <span class="text-slate-500">github.com/e-gleba/airstrike3d-tools</span>
        </div>
        <p class="text-slate-700">Reverse engineering toolkit for AirStrike 3D. Binary analysis, APK asset extraction, game preservation tooling. 23 stars.</p>
      </div>
      <div>
        <div class="flex justify-between items-baseline">
          <strong class="text-[11pt]">wemod_enhancer</strong>
          <span class="text-slate-500">github.com/e-gleba/wemod_enhancer</span>
        </div>
        <p class="text-slate-700">WeMod patcher reimplemented in native C++/CMake — no C# runtime. Adopted via r/PiratedGames community. 13 stars, 5 forks.</p>
      </div>
      <div>
        <div class="flex justify-between items-baseline">
          <strong class="text-[11pt]">euengine</strong>
          <span class="text-slate-500">github.com/e-gleba/euengine</span>
        </div>
        <p class="text-slate-700">3D game engine on SDL3 with hot reload. Modern C++ architecture, data-oriented design.</p>
      </div>
    </div>
  </section>
  <section>
    <h2 class="text-[12pt] font-bold uppercase tracking-wider border-b border-slate-300 pb-1 mb-2">Languages</h2>
    <p class="text-[10pt]">English (Professional), Russian (Native), Chinese (Conversational)</p>
  </section>
</div>
